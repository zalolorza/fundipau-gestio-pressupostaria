DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
BETTER_AUTH_SECRET=genera-una-clau-amb-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
ALLOW_SIGNUP=false

# SMTP (correus transaccionals: restabliment de contrasenya, …)
# 465 = SSL implícit (recomanat); 587 = STARTTLS obligatori
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fundipau <noreply@fundipau.org>"
